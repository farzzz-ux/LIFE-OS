{
  "name": "life-os-tracker",
  "version": "1.0.0",
  "description": "Production-ready, full-stack dark-themed Life Command Center with real-time atomic JSON persistence, accurate weighted Life Score analytics, and dual-layer state synchronization.",
  "main": "server.cjs",
  "type": "commonjs",
  "scripts": {
    "start": "node server.cjs",
    "dev": "nodemon server.cjs",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
