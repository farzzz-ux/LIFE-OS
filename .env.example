# LIFE OS Environment Configuration Example
# Copy this file to .env and customize for your environment

# Application Port
PORT=3000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# JWT Secret Key (MUST be at least 32 characters in production)
JWT_SECRET=lifeos-cloud-sync-super-secure-production-jwt-token-key-2026

# Database Path
DB_PATH=./data/lifeos.db

# Backup Retention (number of backups to retain)
BACKUP_RETENTION_COUNT=7

# Rate Limiting (requests per 15 minutes window)
AUTH_RATE_LIMIT_MAX=100
API_RATE_LIMIT_MAX=1000

# Optional Cloud PostgreSQL Connection String (Supabase / Render PG)
# When set, LIFE OS persists data to Cloud PostgreSQL with automatic SQLite local fallback
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

